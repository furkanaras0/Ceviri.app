# ==========================================
# Python & Bytecode
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Sanal Ortamlar (Virtual Environments)
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# PyInstaller & Derleme Çıktıları
# ==========================================
build/
dist/
*.egg-info/
*.spec

# ==========================================
# Yerel Veritabanı ve Çalışma Önbellekleri
# ==========================================
data/*.db
data/*.db-journal
data/*.sqlite*
data/extracted_images/*
data/scanned_pages/*
data/test_imgs/*
!data/.gitkeep

# ==========================================
# Kullanıcı Dosyaları (PDF & Word Çıktıları)
# ==========================================
çevrilen/*
!çevrilen/.gitkeep
çevrilmiş/*
!çevrilmiş/.gitkeep
*.pdf
*.docx
!docs/*.docx

# ==========================================
# Gizli Bilgiler ve Ortam Değişkenleri
# ==========================================
.env
.env.*
*.key
*.pem
credentials.json
secrets.json

# ==========================================
# Editör ve IDE Dosyaları
# ==========================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ==========================================
# İşletim Sistemi Dosyaları
# ==========================================
Thumbs.db
desktop.ini
.DS_Store

# ==========================================
# Log Dosyaları
# ==========================================
*.log
